{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Alien Cockpit OSS",
  "version": "0.1.0",
  "identifier": "oss.aliencockpit.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5181",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Alien Cockpit OSS",
        "width": 1180,
        "height": 760,
        "minWidth": 520,
        "minHeight": 440,
        "center": true,
        "backgroundColor": "#0d0f14",
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
